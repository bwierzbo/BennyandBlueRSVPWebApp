# Database Configuration
# Neon PostgreSQL Database Connection String
POSTGRES_URL="postgresql://username:password@hostname:port/database?sslmode=require"

# Alternative format for @vercel/postgres (required for Vercel deployment)
POSTGRES_PRISMA_URL="postgresql://username:password@hostname:port/database?sslmode=require&pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://username:password@hostname:port/database?sslmode=require"

# Authentication Configuration
NEXTAUTH_SECRET="your-secret-key-here-minimum-32-characters"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
APP_URL="http://localhost:3000"
WEDDING_DATE="2026-08-22"
RSVP_DEADLINE="2026-07-01"

# Production Environment Variables (set in Vercel Dashboard)
# NODE_ENV="production"
# VERCEL_URL (automatically set by Vercel)

# Optional: Analytics & Monitoring
# VERCEL_ANALYTICS_ID=""

# Optional: Error Tracking
# SENTRY_DSN=""

# Email Configuration
# Resend API Key for sending confirmation emails
RESEND_API_KEY="re_your_api_key_here"

# Admin Authentication
# Email and password required to access admin dashboard and protected API routes
ADMIN_EMAIL="your-admin-email@example.com"
ADMIN_PASSWORD="your-secure-admin-password-here"

# Notification Email
# Email address to receive new RSVP notifications (couple's email)
NOTIFICATION_EMAIL="your-email@example.com"

# Memories page (/memories) - see MEMORIES_SETUP.md
# Cloudflare R2 bucket that guest photos & videos upload to (server-side only)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="bennyandblue-guest-media"

# Wedding film shown on /memories. NEXT_PUBLIC_* values are inlined at build
# time, so redeploy after changing them.
# The ID of the YouTube video: the part after youtu.be/ or watch?v=
NEXT_PUBLIC_FILM_YOUTUBE_ID=""
# Optional: direct MP4 URL. When set, a native video player replaces YouTube.
# NEXT_PUBLIC_FILM_MP4_URL="https://example.com/film.mp4"
